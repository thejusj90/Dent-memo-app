# Point this at dentmemo-labs (the sandbox project) -- NEVER at
# Dr. Blessin's project or the live DentMemo Product project.
#
# Use the DIRECT connection string (port 5432), not the pooled one (6543).
# Find it in Supabase Dashboard -> Project Settings -> Database -> Connection string.
# The `postgres` role bypasses RLS, which is what lets this script write
# rows without going through auth/RLS at all.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Scale knobs. Defaults below (~200 clinics) run in a few minutes on a laptop
# and are enough to see RLS/index behavior diverge from a toy dataset.
# For a true "10,000 dentist accounts" rehearsal, raise CLINICS to 10000 and
# expect this to take a while -- run it against dentmemo-labs, not locally,
# and consider running overnight.
SEED_CLINICS=200
SEED_PATIENTS_PER_CLINIC_MIN=150
SEED_PATIENTS_PER_CLINIC_MAX=600
SEED_YEARS_OF_HISTORY=3
SEED_VISITS_PER_PATIENT_PER_YEAR=3
SEED_RANDOM_SEED=dentmemo-loadtest

# How many clinics to process concurrently. Keep this modest -- Supabase's
# direct connection has a real connection limit, and this script opens one
# connection per worker via a pool.
SEED_CONCURRENCY=8

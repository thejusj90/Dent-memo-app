NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# DentMemo Consent client configuration
NEXT_PUBLIC_CONSENT_DEMO_MODE=false
NEXT_PUBLIC_CONSENT_PRICE_DISPLAY=₹999/year

# Configure these as Supabase Edge Function secrets, not browser variables.
# RESEND_API_KEY=re_...
# CONSENT_FROM_EMAIL=DentMemo Consent <consent@yourdomain.com>
# RAZORPAY_KEY_ID=rzp_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
# RAZORPAY_CONSENT_PLAN_ID=plan_...
# RAZORPAY_CONSENT_TOTAL_COUNT=10
# CONSENT_PLAN_NAME=DentMemo Consent Annual
# CONSENT_PRICE_DISPLAY=₹999/year
